rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function bounded(value, minimum, maximum) {
      return value is number && value >= minimum && value <= maximum;
    }

    function validProfile(data) {
      let fields = [
        'birthYear', 'heightCm', 'startingWeightKg', 'currentWeightKg',
        'activity', 'windowStart', 'windowEnd', 'locale', 'timezone',
        'weeklyBudgetJod', 'calories', 'proteinGrams', 'carbsGrams',
        'fatGrams', 'waterMl', 'confirmationVersion', 'updatedAt', 'confirmedAt'
      ];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.birthYear is int && bounded(data.birthYear, request.time.year() - 125, request.time.year())
        && bounded(data.heightCm, 50, 300)
        && bounded(data.startingWeightKg, 10, 700)
        && bounded(data.currentWeightKg, 10, 700)
        && data.activity in ['veryLow', 'low', 'moderate', 'high']
        && data.windowStart is string && data.windowStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.windowEnd is string && data.windowEnd.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.locale in ['ar', 'en']
        && data.timezone is string && data.timezone.size() <= 100
        && data.timezone.matches('^(UTC|[A-Za-z_+-]+(/[A-Za-z0-9_+-]+)+)$')
        && bounded(data.weeklyBudgetJod, 0, 100000)
        && data.calories is int && bounded(data.calories, 1, 20000)
        && bounded(data.proteinGrams, 0, 5000)
        && bounded(data.carbsGrams, 0, 5000)
        && bounded(data.fatGrams, 0, 5000)
        && data.waterMl is int && bounded(data.waterMl, 0, 30000)
        && data.confirmationVersion is int && data.confirmationVersion == 1
        && data.confirmedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.confirmedAt == request.time;
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.confirmedAt
          == resource.data.get('confirmedAt', request.time);
    }

    function hasConfirmedProfile(uid) {
      let owner = get(/databases/$(database)/documents/users/$(uid)).data;
      return owner.confirmationVersion == 1 && owner.confirmedAt is timestamp;
    }

    function validMeal(data, mealId) {
      let fields = ['id', 'dayKey', 'eatenAtUtc', 'timezone', 'type',
        'status', 'servings', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.id == mealId
        && mealId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && data.dayKey is string && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.eatenAtUtc is timestamp
        && data.timezone is string && data.timezone.size() <= 100
        && data.type in ['breakfast', 'lunch', 'dinner', 'snack']
        && data.status in ['draft', 'confirmed', 'deleted']
        && data.servings is list && data.servings.size() <= 50
        && (data.status != 'confirmed' || data.servings.size() > 0)
        && data.updatedAt == request.time;
    }

    match /users/{uid}/meals/{mealId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && hasConfirmedProfile(uid)
        && request.resource.data.status != 'deleted'
        && validMeal(request.resource.data, mealId);
      allow update: if isOwner(uid) && hasConfirmedProfile(uid)
        && validMeal(request.resource.data, mealId)
        && (
          (resource.data.status != 'deleted' && request.resource.data.status != 'deleted')
          || (request.resource.data.status == 'deleted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
    }

    function uuid(id) {
      return id is string && id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    function validWater(data, id) {
      let fields = ['id', 'ml', 'recordedAt', 'dayKey', 'timezone', 'deleted', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && uuid(id) && data.id == id
        && data.ml is int && bounded(data.ml, 1, 10000)
        && data.recordedAt is timestamp
        && data.dayKey is string && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.timezone is string && data.timezone.size() <= 100
        && data.deleted is bool && data.updatedAt == request.time;
    }

    match /users/{uid}/water/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && hasConfirmedProfile(uid)
        && validWater(request.resource.data, id) && request.resource.data.deleted == false;
      allow update: if isOwner(uid) && hasConfirmedProfile(uid)
        && validWater(request.resource.data, id)
        && (
          (request.resource.data.deleted == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'updatedAt']))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        );
    }

    function validFast(data) {
      let fields = ['id', 'startedAt', 'plannedEndAt', 'actualEndAt',
        'timezone', 'status', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && uuid(data.id)
        && data.startedAt is timestamp && data.plannedEndAt is timestamp
        && data.plannedEndAt > data.startedAt
        && data.timezone is string && data.timezone.size() <= 100
        && (
          (data.status == 'active' && data.actualEndAt == null)
          || (data.status in ['ended', 'cancelled']
            && data.actualEndAt is timestamp && data.actualEndAt >= data.startedAt)
        )
        && data.updatedAt == request.time;
    }

    function matchesFastHistory(uid, data) {
      return getAfter(/databases/$(database)/documents/users/$(uid)/fastingHistory/$(data.id)).data == data;
    }

    match /users/{uid}/fasting/current {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && hasConfirmedProfile(uid)
        && validFast(request.resource.data) && request.resource.data.status == 'active';
      allow update: if isOwner(uid) && hasConfirmedProfile(uid)
        && validFast(request.resource.data)
        && (
          (resource.data.status != 'active' && request.resource.data.status == 'active'
            && request.resource.data.id != resource.data.id)
          || (resource.data.status == 'active' && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']))
          || (resource.data.status == 'active'
            && request.resource.data.status in ['ended', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'actualEndAt', 'updatedAt'])
            && matchesFastHistory(uid, request.resource.data))
        );
    }

    match /users/{uid}/fastingHistory/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && hasConfirmedProfile(uid)
        && validFast(request.resource.data)
        && request.resource.data.id == id
        && request.resource.data.status in ['ended', 'cancelled']
        && getAfter(/databases/$(database)/documents/users/$(uid)/fasting/current).data == request.resource.data;
    }

    function validWeight(data, id) {
      let fields = ['id', 'kg', 'measuredAt', 'timezone', 'notes', 'deleted', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && uuid(id) && data.id == id
        && bounded(data.kg, 10, 700)
        && data.measuredAt is timestamp
        && data.timezone is string && data.timezone.size() <= 100
        && (data.notes == null || (data.notes is string && data.notes.size() <= 500))
        && data.deleted is bool && data.updatedAt == request.time;
    }

    match /users/{uid}/weights/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && hasConfirmedProfile(uid)
        && validWeight(request.resource.data, id) && request.resource.data.deleted == false;
      allow update: if isOwner(uid) && hasConfirmedProfile(uid)
        && validWeight(request.resource.data, id)
        && (
          (resource.data.deleted == false && request.resource.data.deleted == false)
          || (request.resource.data.deleted == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'updatedAt']))
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
